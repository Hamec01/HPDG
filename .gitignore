# Build outputs
build/
**/build/
build-*/
# JUCE's own CMake helpers live in JUCE/extras/Build; on case-insensitive
# file systems (Windows) the rules above would otherwise drop it from the repo.
!JUCE/extras/Build/
Binaries/

# IDE
.vs/
.vscode/
*.VC.db
*.VC.opendb

# CMake intermediates
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# JUCE generated binaries
**/*_artefacts/

# Runtime/generated artifacts
StyleLabReferences/**
TempMidi/**
Logs/*.log
Logs/*.png
drag.log
contract-out.txt
contract-err.txt
Releases/
/Release/
/Installer/Output/
/Vst3ViewerTmp/
*.zip

# OS
Thumbs.db
.DS_Store
